{
  "name": "@swttch/extend-kit",
  "version": "0.4.0",
  "description": "Companion tools for Swttch that live outside the plugin bundle: Claude Code account/usage SDK, the ccb CLI, and speech-to-text.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./battery": {
      "types": "./dist/battery/index.d.ts",
      "default": "./dist/battery/index.js"
    },
    "./stt": {
      "types": "./dist/stt/index.d.ts",
      "default": "./dist/stt/index.js"
    },
    "./cli": "./dist/cli/index.js"
  },
  "bin": {
    "ccb": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "keywords": [
    "claude",
    "claude-code",
    "swttch",
    "sdk",
    "cli"
  ],
  "license": "MIT",
  "author": "yhk1038",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swttch/extend-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
