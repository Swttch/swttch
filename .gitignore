# IDE & Editor
.idea/
.vscode/
.fleet/
*.iws
*.ipr
*.iml
ignore/

# 에이전트가 자동으로 읽는 지침 중, 공개 저장소에 넣지 않을 것들. CLAUDE.md는
# 커밋되는 공개 문서이고, 이쪽은 같은 방식으로 로드되지만 우리끼리만 보는 쪽이다.
CLAUDE.local.md

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties

# IntelliJ
out/
.intellijPlatform/
.kotlin/

# Node.js / WebView
webview/node_modules/
webview/dist/
.vite/

# node_modules ANYWHERE, not just at the two paths above. The anchored rules
# missed `backend/lib/node_modules/`, which is where an `npm i -g --prefix
# backend` lands — and 74 files of a globally-installed package were committed
# that way in #293. The backend then found that copy and reported the kit as
# installed no matter how many times it was uninstalled, because nothing a
# package manager does can remove a tracked source file.
node_modules/

# WebView build output
src/main/resources/webview/

# Node.js backend build output
backend/node_modules/
backend/dist/
src/main/resources/backend/

# What `npm i -g --prefix backend` leaves behind besides node_modules: the
# linked bin. Ignored so a stray global install cannot be committed again.
backend/bin/
backend/lib/

# Release artifacts (ccg tgz, runtime tgz)
/dist/

# TypeScript build info
*.tsbuildinfo

# TypeScript in-place compile artifacts
backend/src/**/*.js

# Vite config build artifacts
webview/vite.config.d.ts
webview/vite.config.js

# Test coverage & reports
webview/coverage/
webview/html/
backend/coverage/

# Claude Code / OMC
.claude.json
# .claude/ — whitelist policy: local by default; only shared contributor
# skills are tracked. Owner-only skills (deploy, precheck, release-monitor,
# cc-gui-reporter), personal settings/backups, and internal docs stay local.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/pr-checklist/
!.claude/skills/add-locale/
.claude-code-gui/
.omc/
.taskmaster/

# OS
.DS_Store

# Environment (secrets)
# Ignore every real .env file — they hold build-injected keys.
# Only the committed .env.example template is tracked (see negation below).
.env
.env*
!.env.example

# Logs
*.log
npm-debug.log*

www/

# scripts/ — whitelist policy: everything under scripts/ is local by
# default; only the shared, non-owner developer tools below are tracked.
# Deploy/marketplace scripts (release.sh, marketplace-monitor.sh,
# verifier-allowlist.txt) are owner-only — like the .claude/ deploy
# skills — and intentionally stay local-only (not re-included here).
scripts/*
!scripts/build.sh
!scripts/zombies.sh
!scripts/all-build-run-ide.sh
!scripts/sync-announcement-core.sh

# Swttch 관련 패키지 저장소들이 사는 곳. 각각 독립된 git 저장소라 이 저장소는
# 추적하지 않는다. 훗날 모노레포로 전환한다면 이 한 줄을 지우고 workspace를
# 설정하면 된다 — 그때를 위해 디렉토리 구조는 packages/<이름> 관례를 따라 둔다.
packages/
